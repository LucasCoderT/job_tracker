<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.codertheory.jobtracker.jd-capture</string>

    <!-- Fetches the job descriptions Cloudflare cannot: LinkedIn answers the
         Worker with 429 but answers this Mac. Same parser as the Worker
         (server/utils/jd-capture.ts), paced, capped at 20 per run. -->
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/node</string>
        <string>/Users/lucas/Developer/job_tracker/scripts/capture-jds.mjs</string>
    </array>

    <key>StartInterval</key>
    <integer>1800</integer>
    <key>RunAtLoad</key>
    <false/>

    <key>WorkingDirectory</key>
    <string>/Users/lucas/Developer/job_tracker</string>
    <key>StandardOutPath</key>
    <string>/Users/lucas/Library/Logs/job-tracker-jd-capture.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/lucas/Library/Logs/job-tracker-jd-capture.log</string>
</dict>
</plist>
