<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.codertheory.jobtracker.reconcile</string>

    <!-- 07:30, just after career-ops pushes the morning's postings at 07:15, so
         the day's list is already correct the first time he opens it — and
         anything he applied to on an employer's own site the night before stops
         showing as untouched. Idempotent: it only fills a blank link. -->
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/node</string>
        <string>/Users/lucas/Developer/job_tracker/scripts/reconcile-postings.mjs</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/lucas/Developer/job_tracker</string>

    <key>StandardOutPath</key>
    <string>/Users/lucas/Library/Logs/job-tracker-reconcile.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/lucas/Library/Logs/job-tracker-reconcile.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
